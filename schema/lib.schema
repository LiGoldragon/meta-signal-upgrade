{}
[(Register Registration)
 (Allow PolicyRange)
 (Block Block)
 (Query Query)
 (ForceFlip ForceFlip)
 (Rollback Rollback)
 (Quarantine Quarantine)]
[(Registered Registration)
 (Allowed PolicyRange)
 (Blocked Block)
 (PolicyReported PolicyReported)
 (PolicyRejected PolicyRejected)
 (FlipForced ForcedFlip)
 (RolledBack RolledBack)
 (Quarantined Quarantined)
 (Rejected Rejected)
 (RequestUnimplemented RequestUnimplemented)]
{
  ComponentName String
  MigrationIdentifier String
  ContractVersion { byte (Vec Integer) }
  MigrationVersion { major Integer minor Integer patch Integer }
  MigrationState [Enabled Disabled]
  Registration { component ComponentName source MigrationVersion target MigrationVersion migration MigrationIdentifier state MigrationState }
  PolicyRange { component ComponentName source MigrationVersion target MigrationVersion }
  BlockReason [Unsafe Superseded NotReviewed]
  Block { component ComponentName source MigrationVersion target MigrationVersion reason BlockReason }
  Query [All (Component ComponentName)]
  PolicyEntry { component ComponentName source MigrationVersion target MigrationVersion state MigrationState }
  PolicyReported { entries (Vec PolicyEntry) }
  CatalogueRejectionReason [UnknownMigration AlreadyRegistered NotAllowed]
  PolicyRejected { component ComponentName source MigrationVersion target MigrationVersion reason CatalogueRejectionReason }
  VersionLabel String
  SelectorVersion { label VersionLabel contract_version ContractVersion }
  ForceReason [OperatorOverride MarkerMismatchAccepted EmergencyRecovery]
  RollbackReason [PostCutoverFailure OperatorOverride RecoveryDrill]
  QuarantineReason [FailedUpgrade SuspectState OperatorHold]
  ForceFlip { component ComponentName current_version SelectorVersion target_version SelectorVersion reason ForceReason }
  Rollback { component ComponentName active_version SelectorVersion restore_version SelectorVersion reason RollbackReason }
  Quarantine { component ComponentName version SelectorVersion reason QuarantineReason }
  ForcedFlip { component ComponentName active_version SelectorVersion }
  RolledBack { component ComponentName active_version SelectorVersion }
  Quarantined { component ComponentName version SelectorVersion }
  SelectorRejectionReason [UnknownComponent UnknownVersion NotAllowed AlreadyQuarantined NotQuarantined VersionQuarantined HandoverRejected UpgradeSocketUnavailable]
  Rejected { component ComponentName reason SelectorRejectionReason }
  UnimplementedReason [NotBuiltYet IntegrationNotLanded]
  RequestUnimplemented { reason UnimplementedReason }
}
